// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ForecastSnapshot {
  shop       String   @id
  data       String
  status     String   @default("ready") // "ready" | "computing"
  computedAt DateTime @default(now())
  lockedAt   DateTime?
}

// Tedarik süresi (lead time) + sipariş kapsama günü ayarları — mağaza
// bazında, "sipariş ayarları" sihirbazından geliyor (bkz. shopSettings.server.ts).
// onboardedAt null ise sihirbaz hiç tamamlanmamış demek; panelde bir
// hatırlatma kartı gösterip göstermeyeceğimizi bununla belirliyoruz.
model ShopSettings {
  shop         String    @id
  leadTimeDays Int       @default(14)
  coverageDays Int       @default(30)
  onboardedAt  DateTime?
  // Karşılama turu (WelcomeTour) sadece ilk açılışta gösterilmeli, bir
  // daha ASLA tekrar çıkmamalı — bunu tarayıcı belleği (localStorage)
  // yerine burada, sunucu tarafında kalıcı tutuyoruz (bkz.
  // shopSettings.server.ts: hasTourBeenSeen/markTourSeen). Satır henüz
  // sipariş ayarları yapılmamış bir mağaza için de erkenden (tur
  // görüldüğünde) oluşturulabiliyor — onboardedAt'tan bağımsız bir alan.
  tourSeenAt   DateTime?
}

// "Ertele" (snooze) — kalıcı bir mute yerine SÜRELİ erteleme (bkz.
// snooze.server.ts). snoozeUntil null ise süresiz ertelenmiş demek.
// Süresi geçmiş bir kayıt otomatik olarak "aktif değil" sayılır (tembel
// süre kontrolü — forecastSnapshot'taki kilit mantığıyla aynı yaklaşım),
// ayrı bir temizlik işine gerek yok.
model SnoozedVariant {
  id          String    @id @default(cuid())
  shop        String
  variantId   String
  snoozeUntil DateTime?
  createdAt   DateTime  @default(now())

  @@unique([shop, variantId])
}