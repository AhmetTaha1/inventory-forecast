# ---------------------------------------------------------------------------
# Ortam değişkenleri ŞABLONU — bu dosya git'e girer ve ASLA gerçek sır içermez.
# Kurulum: bu dosyayı ".env" olarak kopyala ve değerleri doldur.
#   cp .env.example .env
#
# Üretime dağıtım yaparken bu değişkenleri barındırma platformunun kendi
# "environment variables" ekranına girmen gerekir — .env dosyası git'e
# gitmediği için sunucuya kendiliğinden taşınmaz.
# ---------------------------------------------------------------------------


# --- Veritabanı (ZORUNLU) --------------------------------------------------
# PostgreSQL bağlantı adresi. Host adında "-pooler" OLMAMALI: uygulama sürekli
# çalışan bir Node sürecinde döner, Prisma kendi bağlantı havuzunu yönetir ve
# migration'lar havuzlanmış bağlantıda sorun çıkarır.
# Eksikse: uygulama hiç açılmaz (Prisma net bir hata verir).
DATABASE_URL="postgresql://KULLANICI:SIFRE@HOST/VERITABANI?sslmode=require"


# --- Shopify uygulama kimliği (ZORUNLU) ------------------------------------
# Yerelde `npm run dev` (Shopify CLI) bunları otomatik enjekte eder, .env'e
# yazmana gerek yoktur. ÜRETİMDE ise elle tanımlanmaları şarttır.
# Partner Dashboard > uygulaman > "Client credentials" altında bulunur.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,read_all_orders,read_products,read_inventory,read_locations
# Uygulamanın herkese açık adresi (sonunda "/" olmadan), ör. https://app.alanadin.com
# E-posta özetindeki "uygulamada görüntüle" bağlantısı da bunu kullanır.
SHOPIFY_APP_URL=


# --- Ücretlendirme / abonelik (ÜRETİMDE ZORUNLU) ---------------------------
# Partner Dashboard > Settings > API clients'tan "Manage apps" izinli bir
# Partner API token'ı oluştur.
#
# DİKKAT — SESSİZ GELİR KAYBI: bu ikisi tanımlı DEĞİLSE abonelik kontrolü
# tamamen devre dışı kalır ve uygulamayı kuran HERKES ücretsiz kullanır.
# Hata vermez, sadece para tahsil edilmez. Üretimde mutlaka doldur.
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=


# --- Günlük e-posta özeti (özellik kullanılacaksa ZORUNLU) -----------------
# resend.com > API Keys'ten alınır. Gönderen adresin Resend'de DOĞRULANMIŞ bir
# alan adına ait olması gerekir.
#
# DİKKAT — SESSİZ ARIZA: bu ikisi eksikse mağaza sahibi ayarlardan günlük
# özeti açabilir, "kaydedildi" onayını görür ama e-posta HİÇ gitmez.
RESEND_API_KEY=
RESEND_FROM_EMAIL=


# --- Yalnızca geliştirme (üretimde TANIMLAMA) ------------------------------
# scripts/seed-catalog.ts test kataloğu oluştururken kullanır. Gerçek yazma
# yetkisi olan bir Admin API token'ıdır; işin bitince Shopify admin'den iptal
# etmen önerilir. Üretim sunucusuna ASLA konulmamalıdır.
# SEED_SHOP=magazan.myshopify.com
# SEED_TOKEN=

# Mağaza özel alan adı kullanıyorsa (nadir). Boş bırakılabilir.
# SHOP_CUSTOM_DOMAIN=
